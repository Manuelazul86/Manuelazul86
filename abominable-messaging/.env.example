# =====================================================================
# ABOMINABLE MESSAGING — plantilla de variables de entorno
#
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA debe subirse a git (ya está en .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE
# Dónde: https://supabase.com/dashboard → tu proyecto → Settings → API
# ---------------------------------------------------------------------
# Project URL. Público (viaja al navegador).
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key. Público por diseño: RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. SECRETO ABSOLUTO. Ignora RLS.
# Sólo se usa en el servidor (rutas /api/n8n/* y el webhook).
# Si se filtra, rota la llave inmediatamente en Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# WHATSAPP BUSINESS CLOUD API (Meta)
# Dónde: https://developers.facebook.com/apps → tu app → WhatsApp → API Setup
# ---------------------------------------------------------------------
# Token de acceso. El temporal dura 24 h; para producción genera uno
# permanente desde un System User en Meta Business Suite.
WHATSAPP_ACCESS_TOKEN=

# ID del número remitente (NO el número de teléfono: el ID numérico).
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Cadena que TÚ inventas. La escribes aquí y la misma en el panel de Meta
# al configurar el webhook. Meta la devuelve en el handshake para probar
# que el endpoint es tuyo.
#   Genera una con: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta (Settings → Basic → App Secret).
# Se usa para verificar la firma X-Hub-Signature-256 de cada webhook.
# Sin esto, cualquiera podría inventar estados de entrega.
META_APP_SECRET=

# Versión de Graph API. Opcional; por defecto v21.0.
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------
# MODO MOCK
# true  = los envíos se simulan, no salen a WhatsApp (desarrollo).
# false = envíos reales contra la Cloud API.
# En producción con true, la app muestra un banner de advertencia.
# ---------------------------------------------------------------------
WHATSAPP_MOCK_MODE=true

# ---------------------------------------------------------------------
# N8N
# Cadena que TÚ inventas y configuras también en n8n como credencial.
# Protege /api/n8n/* — sin ella cualquiera podría reclamar y enviar.
#   Genera una con: openssl rand -hex 32
# ---------------------------------------------------------------------
N8N_API_SECRET=

# ---------------------------------------------------------------------
# APLICACIÓN
# URL pública. En local http://localhost:3000; en Vercel la del deployment.
# Se usa para construir la URL del webhook que registras en Meta.
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
